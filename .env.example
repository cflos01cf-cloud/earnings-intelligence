# ─────────────────────────────────────────────────────────────────────────────
# Earnings Intelligence — variables de entorno
# Copia a .env.local (tu PC) o captúralas en GitHub (Secrets/Variables) y en Netlify.
# NUNCA subas valores reales al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# live = datos reales del almacén · demo = snapshot SINTÉTICO de .data/demo (npm run demo:build)
DATA_MODE=live

# --- Fuentes de datos (todas gratuitas; cada una es opcional e independiente) ---
# SEC EDGAR: no requiere llave, pero exige un correo de contacto en el User-Agent.
SEC_CONTACT_EMAIL=
# Alpha Vantage (consenso histórico de EPS). Plan gratuito ≈ 25 peticiones/día: el presupuesto deja margen.
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_DAILY_LIMIT=20
ALPHAVANTAGE_RATE_PER_MIN=5
# Finnhub (calendario y consenso de EPS e ingresos de próximos reportes).
FINNHUB_API_KEY=
# TwelveData (precios diarios). Puedes usar una cuenta propia de este proyecto.
TWELVEDATA_API_KEY=
TWELVEDATA_RATE_PER_MIN=8
# Tope de consultas de precios por corrida (el plan gratuito da 800 créditos al día).
TWELVEDATA_MAX_PER_RUN=400

# --- Universo ---
# on = incluye ~168 acciones medianas de EE.UU. además de las de GBM (recomendado para buscar ventaja).
UNIVERSE_EXPANSION=on

# --- GBM Weekly Trend (solo lectura: universo, posiciones y watchlist) ---
GBM_NETLIFY_SITE_ID=
GBM_BLOBS_TOKEN=

# --- Almacén propio (Netlify Blobs del sitio earnings-intelligence) ---
# file = .data/ en tu PC · netlify-blobs = producción. Sin STORAGE: Netlify Blobs dentro de Netlify, archivos fuera.
STORAGE=
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# --- App ---
APP_PASSWORD=

# --- Costos (por lado, en %). GBM EE.UU.: 0.25% + IVA ---
COST_COMMISSION_PCT=0.25
COST_VAT_PCT=16
COST_SLIPPAGE_PCT=0.05
COST_SPREAD_PCT=0.03
