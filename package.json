{
  "name": "earnings-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Earnings Intelligence AI — reacción bursátil a resultados trimestrales (quinto motor del Global Quant Hub)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "universe:sync": "tsx --env-file-if-exists=.env.local scripts/universe-sync.mts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.mts",
    "predict": "tsx --env-file-if-exists=.env.local scripts/predict.mts",
    "backtest": "tsx --env-file-if-exists=.env.local scripts/backtest.mts",
    "ci:daily": "tsx --env-file-if-exists=.env.local scripts/ci-daily.mts",
    "probe": "tsx --env-file-if-exists=.env.local scripts/probe.mts",
    "demo:build": "tsx scripts/demo-build.mts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "next": "^15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
